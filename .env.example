# Vercel AI Gateway. On Vercel deployments, OIDC is used automatically;
# locally, `vercel env pull` provides VERCEL_OIDC_TOKEN, or set an API key here.
AI_GATEWAY_API_KEY=

# PostHog AI observability (optional; tracing is skipped when unset)
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
